/*Given an integer ‘K’ and a tree in string format. We had to print the sum of all elements at Kth level from root. For example:-
                            0
                          /     \
                       5         7
                    /    \      /   \
                   6       4    1     3
                            \
                             9 
Tree was given in the form: (node value(left subtree)(right subtree)) For tree given above: (0(5(6()())(4()(9()())))(7(1()())(3()()))) Input format: K Tree Output format: Sum For example, for given tree: Input: 2 (0(5(6()())(4()(9()())))(7(1()())(3()()))) Output: 14 
*/
#include <bits/stdc++.h>
using namespace std;

int kLevelSum(string &s, int k) {
    int level = -1;
    int sum = 0;

    for (int i = 0; i < s.size();) {

        if (s[i] == '(') {
            level++;
            i++;
        }
        else if (s[i] == ')') {
            level--;
            i++;
        }
        else {
            bool neg = false;

            if (s[i] == '-') {
                neg = true;
                i++;
            }

            int num = 0;

            while (i < s.size() && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }

            if (level == k) {
                sum += neg ? -num : num;
            }
        }
    }

    return sum;
}

int main() {
    int k;
    string s;

    cin >> k >> s;

    cout << kLevelSum(s, k) << endl;

    return 0;
}
